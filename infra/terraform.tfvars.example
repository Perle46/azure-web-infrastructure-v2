# Copy to terraform.tfvars and adjust. terraform.tfvars is ignored by Git.
location            = "austriaeast"
zones               = ["1", "3"]
vm_size             = "Standard_B2ats_v2"
min_instances       = 2
max_instances       = 3
ssh_public_key      = "ssh-ed25519 AAAA... azureuser"
enable_bastion      = false
